# ============================================================
# LLM Providers（至少配置一个；修改后需重启 WebUI/CLI）
# ============================================================
# 复制本文件为 .env 后再填写，例如：cp .env.example .env
OPENAI_API_KEY=
GOOGLE_API_KEY=
# Google 也可使用 GOOGLE_GENAI_API_KEY
ANTHROPIC_API_KEY=
XAI_API_KEY=
OPENROUTER_API_KEY=

# MiniMax 的 Anthropic 兼容端点示例（默认配置使用）：
#   方式 A：ANTHROPIC_API_KEY=<your-minimax-key>
#   方式 B：MINIMAX_API_KEY=<your-minimax-key>
#   backend_url 可由下方 TRADINGAGENTS_BACKEND_URL 或 WebUI 覆盖
# 如果使用官方 Anthropic，请在 CLI/WebUI 中把模型改为 claude-* 系列。
MINIMAX_API_KEY=

# ============================================================
# LLM 默认参数（WebUI 初始值 / CLI 默认值）
# ============================================================
# 不配置时使用代码内默认值；WebUI 中也可以临时覆盖
TRADINGAGENTS_LLM_PROVIDER=anthropic
TRADINGAGENTS_DEEP_THINK_LLM=MiniMax-M3
TRADINGAGENTS_QUICK_THINK_LLM=MiniMax-M3.1-Flash
TRADINGAGENTS_BACKEND_URL=https://api.minimax.cn/anthropic
# TRADINGAGENTS_MAX_DEBATE_ROUNDS=1
# TRADINGAGENTS_MAX_RISK_DISCUSS_ROUNDS=1

# 分析师并行执行（默认开启；遇到模型/数据源限流可改为 0 或降低并发）
# TRADINGAGENTS_PARALLEL_ANALYSTS=1
# TRADINGAGENTS_PARALLEL_ANALYSTS_WORKERS=4

# ============================================================
# Data sources
# ============================================================
# Alpha Vantage（可选，免费 Key）
ALPHA_VANTAGE_API_KEY=

# Tavily 联网搜索（可选，用于补充新闻/公告/事件）
# 也兼容 TAVILY_API_KEYS
TAVILY_API_KEY=

# AkShare 请求控制（可选）
AKSHARE_TIMEOUT=30
AKSHARE_MAX_RETRIES=3
AKSHARE_BASE_DELAY=2.0
AKSHARE_REQUEST_INTERVAL=0.5

# 关闭 AkShare 内部进度条（可选，服务端日志更干净）
# TQDM_DISABLE=1

# 分析日志（eval_results）目录
# TRADINGAGENTS_RESULTS_DIR=./eval_results

# yfinance 代理（中国大陆网络可选）
# YFINANCE_PROXY=http://127.0.0.1:7890
# HTTPS_PROXY=http://127.0.0.1:7890

# ============================================================
# Safety / persistence
# ============================================================
# 默认 0（fail-closed）：真实数据源全部失败时直接报错，
# 不允许用模拟行情生成投资建议。仅开发联调时设为 1。
ALLOW_SYNTHETIC_DATA=0

# SQLite 报告数据库路径（默认 <repo>/data/tradingagents.db）
# TA_DB_PATH=./data/tradingagents.db

# ============================================================
# Notifications（Fix 6 MVP，可选）
# ============================================================
# 企业微信 / 飞书 / 通用 Webhook（POST JSON）
# WECOM_WEBHOOK_URL=
# FEISHU_WEBHOOK_URL=
# GENERIC_WEBHOOK_URL=

# ============================================================
# Scheduler（Fix 6 MVP，可选）
# ============================================================
# 每日定时分析时间（HH:MM，北京时间），默认关闭
# SCHEDULE_ENABLED=0
# SCHEDULE_TIME=18:00
# SCHEDULE_STOCKS=600519,000001
# 同时推送自选股策略预警（无触发信号时不推送）
# SCHEDULE_ALERTS=0
# 同时推送市场复盘
# SCHEDULE_REVIEW=0
# 推送合并后的每日盘后简报（优先于上面两项）
# SCHEDULE_BRIEFING=0
