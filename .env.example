# ============================================================
# LLM Providers（至少配置一个；修改后需重启 WebUI/CLI）
# ============================================================
# 复制本文件为 .env 后再填写，例如：cp .env.example .env
OPENAI_API_KEY=
GOOGLE_API_KEY=
# Google 也可使用 GOOGLE_GENAI_API_KEY
ANTHROPIC_API_KEY=
XAI_API_KEY=
OPENROUTER_API_KEY=

# MiniMax 的 Anthropic 兼容端点示例（默认配置使用）：
#   方式 A：ANTHROPIC_API_KEY=<your-minimax-key>
#   方式 B：MINIMAX_API_KEY=<your-minimax-key>
#   backend_url 可由下方 TRADINGAGENTS_BACKEND_URL 或 WebUI 覆盖
# 如果使用官方 Anthropic，请在 CLI/WebUI 中把模型改为 claude-* 系列。
MINIMAX_API_KEY=

# ============================================================
# LLM 默认参数（WebUI 初始值 / CLI 默认值）
# ============================================================
# 不配置时使用代码内默认值；WebUI 中也可以临时覆盖
TRADINGAGENTS_LLM_PROVIDER=anthropic
TRADINGAGENTS_DEEP_THINK_LLM=MiniMax-M3
TRADINGAGENTS_QUICK_THINK_LLM=MiniMax-M3.1-Flash
TRADINGAGENTS_BACKEND_URL=https://api.minimax.cn/anthropic
# TRADINGAGENTS_MAX_DEBATE_ROUNDS=1
# TRADINGAGENTS_MAX_RISK_DISCUSS_ROUNDS=1

# 分析师并行执行（默认开启；遇到模型/数据源限流可改为 0 或降低并发）
# TRADINGAGENTS_PARALLEL_ANALYSTS=1
# TRADINGAGENTS_PARALLEL_ANALYSTS_WORKERS=4

# 单次分析预算（不设置则不限；超限后停止后续 LLM 调用并报错）
# LLM_MAX_COST_PER_RUN=2.0
# LLM_MAX_TOKENS_PER_RUN=800000

# ============================================================
# Data sources
# ============================================================
# Alpha Vantage（可选，免费 Key）
ALPHA_VANTAGE_API_KEY=

# Tavily 联网搜索（可选，用于补充新闻/公告/事件）
# 也兼容 TAVILY_API_KEYS
TAVILY_API_KEY=

# AkShare 请求控制（可选）
AKSHARE_TIMEOUT=30
AKSHARE_MAX_RETRIES=3
AKSHARE_BASE_DELAY=2.0
AKSHARE_REQUEST_INTERVAL=0.5

# 关闭 AkShare 内部进度条（可选，服务端日志更干净）
# TQDM_DISABLE=1

# 分析日志（eval_results）目录
# TRADINGAGENTS_RESULTS_DIR=./eval_results

# yfinance 代理（中国大陆网络可选）
# YFINANCE_PROXY=http://127.0.0.1:7890
# HTTPS_PROXY=http://127.0.0.1:7890

# ============================================================
# Safety / persistence
# ============================================================
# 默认 0（fail-closed）：真实数据源全部失败时直接报错，
# 不允许用模拟行情生成投资建议。仅开发联调时设为 1。
ALLOW_SYNTHETIC_DATA=0

# ============================================================
# 市场范围（默认只做 A 股）
# ============================================================
# 1（默认）：只分析 A 股。非 A 股标的（AAPL / NVDA / 0700.HK）在取数前即被拒绝，
#            不会触发 yfinance 等美股数据源。
# 0        ：恢复多市场能力（需要自行配置 yfinance / alpha_vantage 数据源）。
A_SHARE_ONLY=1

# 0（默认）：data_vendors 里列出的供应商就是完整降级链，未列出的不会被调用。
# 1        ：恢复旧行为 —— 把所有可用供应商追加到降级链末尾（会产生 Yahoo 429 噪音）。
ALLOW_UNCONFIGURED_VENDORS=0

# SQLite 报告数据库路径（默认 <repo>/data/tradingagents.db）
# TA_DB_PATH=./data/tradingagents.db

# ============================================================
# WebUI 鉴权 / 限流 / 部署
# ============================================================
# 单用户模式下的 API Key（可选；设置后所有 /api 需要该密钥）
# WEBUI_API_KEY=
# WEBUI_RATE_LIMIT=120
# WEBUI_RATE_LIMIT_ENABLED=1
# WEBUI_ALLOWED_ORIGINS=http://localhost:8000
# WEBUI_TRUST_PROXY_HEADERS=0
# WEBUI_ANALYSIS_WORKERS=1
# WEBUI_MAX_PENDING_ANALYSES=3
# 实际绑定地址；run_webui.py 默认 127.0.0.1，Docker 中显式 0.0.0.0
# WEBUI_HOST=127.0.0.1
# WEBUI_PORT=8000

# ============================================================
# Multi-user（默认关闭；开启后需要登录，支持 admin/analyst/viewer）
# ============================================================
# WEBUI_MULTI_USER=0
# WEBUI_SESSION_DAYS=7
# 首次启动自动创建管理员；不填密码会生成随机密码写入
# data/initial_admin_password.txt
# WEBUI_ADMIN_USER=admin
# WEBUI_ADMIN_PASSWORD=

# 本地行情仓库（默认开启，日线只下载一次；离线可用）
# TA_MARKET_CACHE=1
# TA_MARKET_DB=./data/market.db

# ============================================================
# Notifications（Fix 6 MVP，可选）
# ============================================================
# 企业微信 / 飞书 / 通用 Webhook（POST JSON）
# WECOM_WEBHOOK_URL=
# FEISHU_WEBHOOK_URL=
# GENERIC_WEBHOOK_URL=

# ============================================================
# Scheduler（Fix 6 MVP，可选，默认关闭）
# ============================================================
# 重要：不设置 SCHEDULE_ENABLED=1 时，WebUI 启动**不会**拉起调度器，
# 也不会自动执行任何分析 —— 分析只能由用户手动触发。
# 每日定时分析时间（HH:MM，北京时间），默认关闭
# SCHEDULE_ENABLED=0
# SCHEDULE_TIME=18:00
# SCHEDULE_STOCKS=600519,000001
# 同时推送自选股策略预警（无触发信号时不推送）
# SCHEDULE_ALERTS=0
# 同时推送市场复盘
# SCHEDULE_REVIEW=0
# 推送合并后的每日盘后简报（优先于上面两项）
# SCHEDULE_BRIEFING=0
# 每日收盘后刷新持仓价并记录组合快照（默认开启，设为 0 关闭）
# SCHEDULE_PORTFOLIO=1
# 每日自动评估到期推荐并写回记忆（默认开启，设为 0 关闭）
# SCHEDULE_EVALUATION=1
# SCHEDULE_EVALUATION_LIMIT=100
# 每日增量同步自选股/持仓/定时标的最近 90 天行情（默认关闭，首次开启会较慢）
# SCHEDULE_DATA_SYNC=0
# 盘中告警：交易时段每 30 秒检查价格/涨跌幅/量比/止损止盈（默认关闭）
# SCHEDULE_INTRADAY_ALERTS=0
# 每日记录自选股/持仓的社媒热度快照（默认关闭）
# SCHEDULE_SOCIAL=0
# 每日盘后全市场选股并归档候选池（默认关闭，首次会拉取业绩报表）
# SCHEDULE_SCREENER=0
# SCHEDULE_SCREENER_TOP=50
# SCHEDULE_SCREENER_STYLE=balanced
