# =============================================================================
# AlphaAgents-CN Docker 部署配置模板
#
# 用法：
#   cp .env.docker.example .env      # 然后填写 LLM 密钥
#   docker compose up -d --build     # 或 scripts/docker-deploy.ps1 -Build
#
# 注意：
#   - 本文件会被 docker compose 读取（env_file + 变量插值），且已 gitignore。
#   - 容器内数据路径固定为 /app/data（由 compose 挂载 ./data），一般不用改。
# =============================================================================

# ============================================================
# LLM 模型密钥（必需，二选一即可）
# ============================================================
# 方式 A：MiniMax（默认配置使用，Anthropic 兼容端点）
ANTHROPIC_API_KEY=
MINIMAX_API_KEY=
TRADINGAGENTS_LLM_PROVIDER=anthropic
TRADINGAGENTS_DEEP_THINK_LLM=MiniMax-M3
TRADINGAGENTS_QUICK_THINK_LLM=MiniMax-M3.1-Flash
TRADINGAGENTS_BACKEND_URL=https://api.minimax.cn/anthropic

# 方式 B：官方 Anthropic（把上面两个 key 换成官方 key，模型改成 claude-*，
#         并清空 TRADINGAGENTS_BACKEND_URL）

# ============================================================
# 可选：联网新闻 / 舆情搜索
# ============================================================
# 不填则新闻/舆情分析降级为"无外部新闻"，不影响其他功能。
TAVILY_API_KEY=

# ============================================================
# Web 服务
# ============================================================
# 宿主机端口（compose 变量插值）
PORT=8000
# 强烈建议开启：设置后访问面板需携带 X-API-Key 或 Authorization: Bearer
# 生成方式：openssl rand -hex 24   （PowerShell: -join ((48..57)+(97..102)|Get-Random -Count 48 | % {[char]$_})）
WEBUI_API_KEY=

# SQLite 数据库路径（容器内，一般不用改）
TA_DB_PATH=/app/data/tradingagents.db

# ============================================================
# 定时任务（可选）
# ============================================================
SCHEDULE_ENABLED=0
# SCHEDULE_TIME=18:00
# SCHEDULE_STOCKS=600519,000001

# ============================================================
# 通知（可选）
# ============================================================
# WECOM_WEBHOOK_URL=
# FEISHU_WEBHOOK_URL=
# GENERIC_WEBHOOK_URL=

# ============================================================
# LLM 输出与可读性
# ============================================================
# 单次回复最大 token 数（Anthropic 兼容端点）。默认 1024 太小，报告会被截断。
LLM_MAX_TOKENS=4096
# 是否额外调一次 LLM 生成"白话版"报告（0=关闭，推荐）
PLAIN_LANGUAGE_REWRITE=0

# ============================================================
# 数据源韧性（AkShare / 东方财富限流）
# ============================================================
DATA_VENDOR_COOLDOWN_SECONDS=300
DATA_VENDOR_TIMEOUT_COOLDOWN_SECONDS=60
DATA_VENDOR_ERROR_COOLDOWN_SECONDS=60
DATA_VENDOR_BREAKER=1
DATA_RESULT_MEMO=1
DATA_RESULT_MEMO_TTL=60
DIRECT_SOURCE_TIMEOUT=8
AKSHARE_RETRY_ON_RATE_LIMIT=0

# ============================================================
# 安全 / 数据
# ============================================================
# 0=禁止用模拟数据兜底（推荐）；1=仅开发联调时允许
ALLOW_SYNTHETIC_DATA=0
# 1=只分析 A 股（默认）；0=允许美股/港股
A_SHARE_ONLY=1

# ============================================================
# 构建期网络（国内网络建议保留）
# ============================================================
# apt / pip 镜像源；留空则使用官方源（国内经常超时）
APT_MIRROR=mirrors.aliyun.com
PIP_INDEX_URL=https://mirrors.aliyun.com/pypi/simple/

# 如镜像源也不通，改用本机代理构建（注意：容器内 127.0.0.1 不是宿主机）
# Docker Desktop:
# BUILD_HTTP_PROXY=http://host.docker.internal:7890
# BUILD_HTTPS_PROXY=http://host.docker.internal:7890
# Linux（宿主机网关）:
# BUILD_HTTP_PROXY=http://172.17.0.1:7890
# BUILD_HTTPS_PROXY=http://172.17.0.1:7890
# BUILD_NO_PROXY=localhost,127.0.0.1,::1

# ============================================================
# 运行期代理（可选：容器内访问模型/新闻接口需要代理时）
# ============================================================
# HTTP_PROXY=http://host.docker.internal:7890
# HTTPS_PROXY=http://host.docker.internal:7890
# NO_PROXY=localhost,127.0.0.1,::1
