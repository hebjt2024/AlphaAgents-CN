# 统一换行符，避免 Windows / Linux 混用导致的 diff 噪声

# 默认：文本文件以 LF 存储，检出时由平台决定
* text=auto eol=lf

# Python 源码
*.py    text eol=lf diff=python
*.pyi   text eol=lf

# 前端与配置
*.js    text eol=lf
*.jsx   text eol=lf
*.ts    text eol=lf
*.tsx   text eol=lf
*.json  text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.toml  text eol=lf
*.md    text eol=lf
*.txt   text eol=lf
*.css   text eol=lf
*.html  text eol=lf
*.sh    text eol=lf

# 明确标记为二进制
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.pdf   binary
*.zip   binary
*.gz    binary
*.whl   binary
*.exe   binary
